{
  "name": "awesome-page-design",
  "version": "0.1.0",
  "description": "支持从零建设多页面系统、设计独立页面和现有项目集成的网页 UI 设计 Skill，覆盖视觉方向、共享组件、核心流程、界面优化与响应式质量。",
  "license": "MIT",
  "type": "commonjs",
  "skills": "./skills/",
  "files": [
    ".codex-plugin/",
    "catalog/",
    "scripts/",
    "skills/",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "previews": "node scripts/generate-previews.js",
    "docs": "node scripts/sync-catalog-docs.js",
    "preview:serve": "node scripts/serve-preview.js",
    "test": "node --test scripts/*.test.js",
    "validate": "node scripts/validate-previews.js",
    "check": "npm test && npm run validate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuschzzp/awesome-page-design.git"
  },
  "keywords": [
    "codex-skill",
    "web-design",
    "existing-project",
    "frontend-integration",
    "style-guide",
    "visual-styles",
    "layout-guidance",
    "design-system",
    "accessibility",
    "ui"
  ],
  "engines": {
    "node": ">=18"
  }
}
